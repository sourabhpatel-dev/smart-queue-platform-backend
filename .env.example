# Local development example — PLACEHOLDERS ONLY. Never commit real secrets.
# From backend/:  Copy-Item .env.example .env   (then adjust values)
# Start infra:    docker compose up -d          (or rely on the built-in defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartqueue
DB_USERNAME=smartqueue
DB_PASSWORD=smartqueue
# Redis holds derived/ephemeral state only (see docs/decisions/ADR-017-redis-foundation.md). No password locally.
REDIS_HOST=localhost
REDIS_PORT=6379
# JWT signing secret (see docs/decisions/ADR-021-authentication-authorization.md): REQUIRED — the application fails fast at
# startup when it is missing or shorter than 32 bytes. Generate a strong
# random value, e.g.:  openssl rand -base64 48
# This file holds placeholders only; the real value lives in your local .env.
JWT_SECRET=change-me-to-at-least-32-bytes-of-randomness
# Browser CORS allow-list for the React frontend (see docs/decisions/ADR-028-frontend-foundation-auth-shell.md): exact
# origin(s) only, comma-separated for more than one. Local default is the
# Vite dev server; production MUST set its real frontend origin(s).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Outbound account email (verification, password reset, invitations).
# Local development delivers through the Mailpit relay in compose.yaml
# (SMTP on localhost:1025, inbox UI on http://localhost:8025) — no real
# credentials needed. Start it with:  docker compose up -d mailpit
# then run the backend with these values (or export them in your shell).
# The default provider `log` records attempts and sends nothing; set
# `smtp` locally to capture real messages in Mailpit. Production sets
# `smtp` with its real relay host/credentials plus STARTTLS, and its
# real public frontend origin (never a localhost URL) — see
# docs/development/README.md ("Account email").
APP_EMAIL_PROVIDER=smtp
APP_EMAIL_FROM_ADDRESS=no-reply@smartqueue.local
APP_EMAIL_FRONTEND_BASE_URL=http://localhost:5173
APP_EMAIL_SMTP_HOST=localhost
APP_EMAIL_SMTP_PORT=1025
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_STARTTLS_ENABLED=false
# Platform-administrator bootstrap (see docs/decisions/ADR-041-organization-onboarding-platform-admin.md): comma-separated account
# emails holding platform review authority (e.g. founder@company.com).
# Empty by default — review endpoints deny everyone until the operator
# sets this. A listed address must still register normally, verify its
# email, and sign in; the role is attached at login and re-checked per
# call. Placeholders only — never commit a real admin address.
APP_PLATFORM_ADMIN_EMAILS=
